# Copy to .env for running locally. Never commit .env.
# On Railway, set these as service Variables instead.
ESPN_LEAGUE_ID=1280240
ESPN_YEAR=2026
# Cookies from espn.com (browser dev tools > Application > Cookies)
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_S2=

# Signs the sign-in cookie. Required when hosted; any long random string.
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# First commissioner, created on startup when there are no accounts yet.
# The password is temporary: you'll choose a new one at first sign-in.
COMMISSIONER_USERNAME=
COMMISSIONER_NAME=
COMMISSIONER_PASSWORD=

# Database: Postgres when DATABASE_URL is set (Railway sets it), otherwise a local SQLite file.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_PATH=dynasty.db

# Optional
# Pull new ESPN activity automatically every N hours (0 or blank = off).
AUTO_SYNC_HOURS=24
PORT=5000
